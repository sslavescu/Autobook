# Required
LOCK_ID=XXXXXXXXXXX
ADMIN_EMAIL=ciacballmachine@gmail.com

# Paths (defaults shown)
DB_PATH=data/pingen.db
SECRETS_DIR=secrets
# GMAIL_CREDENTIALS_PATH=secrets/gmail_credentials.json
# GMAIL_TOKEN_PATH=secrets/gmail_token.json
# IGLOOHOME_CREDENTIALS_PATH=secrets/igloohome_credentials.json

# Optional tuning
# IGLOOHOME_BASE_URL=https://api.igloodeveloper.co/igloohome
# IGLOOHOME_AUTH_URL=https://auth.igloohome.co/oauth2/token
# CLUB_TIMEZONE=Europe/Dublin
# BOOKING_SENDER_FILTER=ebookingonline.net
# BOOKING_SUBJECT_FILTER=Court Booking Confirmation
# How long a new PIN stays valid, in hours. Must be 1-24: algoPINs lasting
# more than 24 hours have to be activated on the lock (used within their first
# 24 hours), and keeping under that means members never have to do anything.
# A new PIN is issued for every booking, so this only needs to cover one slot.
PIN_VALID_HOURS=5
# Cap the PIN's expiry at the member's membership expiry date (23:59 that day).
# CHECK_MEMBERSHIP_EXPIRY=true
# FUZZY_NAME_THRESHOLD=90
# MAX_PROCESS_ATTEMPTS=3
# DRY_RUN=false
# Test mode: send ALL outgoing email to this address instead of real recipients
# EMAIL_REDIRECT_TO=
# Dead-man's switch: pinged after each successful run (e.g. healthchecks.io URL)
# HEALTHCHECK_URL=
# Logging: DEBUG shows API calls, parsing and PIN decisions
# LOG_LEVEL=INFO
# Full HTTP wire dump. WARNING: logs auth tokens and PINs — local debugging only
# LOG_HTTP=false
